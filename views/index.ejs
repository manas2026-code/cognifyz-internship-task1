<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Student Registration</title>

    <!-- Bootstrap CSS -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>
        body {
            background: #f4f7fb;
        }

        .hero {
            padding: 70px 20px;
            background: #212529;
            color: white;
        }

        .form-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .form-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
        }

        .feature-card {
            transition: transform 0.3s ease;
        }

        .feature-card:hover {
            transform: scale(1.03);
        }

        .animate-title {
            animation: fadeIn 1.2s ease-in-out;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>

<body>

    <!-- Navigation -->
    <nav class="navbar navbar-dark bg-dark">
        <div class="container">
            <span class="navbar-brand fw-bold">Student Portal</span>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero text-center">
        <div class="container">
            <h1 class="display-4 fw-bold animate-title">
                Student Registration
            </h1>

            <p class="lead">
                Register yourself for your preferred course.
            </p>
        </div>
    </section>

    <!-- Registration Section -->
    <section class="py-5">
        <div class="container">

            <div class="row justify-content-center">

                <div class="col-lg-7">

                    <div class="card form-card border-0 shadow p-4">

                        <h2 class="text-center mb-4">
                            Registration Form
                        </h2>

                        <form action="/submit" method="POST"
                              onsubmit="return validateForm()">

                            <div class="mb-3">
                                <label class="form-label">Name</label>
                                <input
                                    type="text"
                                    id="name"
                                    name="name"
                                    class="form-control"
                                >
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Email</label>
                                <input
                                    type="email"
                                    id="email"
                                    name="email"
                                    class="form-control"
                                >
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Age</label>
                                <input
                                    type="number"
                                    id="age"
                                    name="age"
                                    class="form-control"
                                >
                            </div>

                            <div class="mb-4">
                                <label class="form-label">Course</label>

                                <select
                                    id="course"
                                    name="course"
                                    class="form-select"
                                >
                                    <option value="">Select Course</option>
                                    <option value="Web Development">
                                        Web Development
                                    </option>
                                    <option value="JavaScript">
                                        JavaScript
                                    </option>
                                    <option value="Python">
                                        Python
                                    </option>
                                </select>
                            </div>

                            <button
                                type="submit"
                                class="btn btn-dark w-100"
                            >
                                Register
                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>
    </section>

    <!-- Features Section -->
    <section class="py-5 bg-white">
        <div class="container">

            <h2 class="text-center mb-4">
                Why Register?
            </h2>

            <div class="row g-4">

                <div class="col-md-4">
                    <div class="card feature-card h-100 border-0 shadow-sm p-3">
                        <h4>Easy Registration</h4>
                        <p>
                            Simple and user-friendly registration process.
                        </p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card feature-card h-100 border-0 shadow-sm p-3">
                        <h4>Responsive Design</h4>
                        <p>
                            The page works on desktop, tablet and mobile screens.
                        </p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card feature-card h-100 border-0 shadow-sm p-3">
                        <h4>Validated Data</h4>
                        <p>
                            User information is validated before submission.
                        </p>
                    </div>
                </div>

            </div>

        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-dark text-white text-center py-3">
        <p class="mb-0">
            Student Portal | Cognifyz Internship
        </p>
    </footer>

    <script>
        function validateForm() {

            const name = document.getElementById("name").value;
            const email = document.getElementById("email").value;
            const age = document.getElementById("age").value;
            const course = document.getElementById("course").value;

            if (name === "" || email === "" || age === "" || course === "") {
                alert("Please fill all fields.");
                return false;
            }

            if (age < 13 || age > 100) {
                alert("Please enter a valid age.");
                return false;
            }

            return true;
        }
    </script>

</body>
</html>