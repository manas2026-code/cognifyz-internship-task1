<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Student Registration</title>

    <!-- Bootstrap CSS -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>
        
        body {
            background: #f4f7fb;
        }

        .hero {
            padding: 70px 20px;
            background: #212529;
            color: white;
        }

        .form-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .form-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
        }

        .feature-card {
            transition: transform 0.3s ease;
        }

        .feature-card:hover {
            transform: scale(1.03);
        }

        .animate-title {
            animation: fadeIn 1.2s ease-in-out;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        #courseInfo {
            display: none;
        }
    </style>
</head>

<body>

    <!-- Navigation -->
    <nav class="navbar navbar-dark bg-dark">
        <div class="container">

            <span class="navbar-brand fw-bold">
                Student Portal
            </span>

            <div>
                <a href="#home" class="btn btn-outline-light btn-sm me-2">
                    Home
                </a>

                <a href="#register" class="btn btn-outline-light btn-sm">
                    Register
                </a>
            </div>

        </div>
    </nav>

    <!-- Authentication Section -->
<section class="container py-5">
    <div class="row g-4">

        <!-- Register -->
        <div class="col-md-6">
            <div class="card shadow p-4">
                <h3 class="mb-3">Create Account</h3>

                <form id="registerForm">
                    <input
                        type="text"
                        id="registerName"
                        class="form-control mb-3"
                        placeholder="Name"
                        required
                    >

                    <input
                        type="email"
                        id="registerEmail"
                        class="form-control mb-3"
                        placeholder="Email"
                        required
                    >

                    <input
                        type="password"
                        id="registerPassword"
                        class="form-control mb-3"
                        placeholder="Password"
                        required
                    >

                    <button type="submit" class="btn btn-primary">
                        Register
                    </button>
                </form>
            </div>
        </div>

        <!-- Login -->
        <div class="col-md-6">
            <div class="card shadow p-4">
                <h3 class="mb-3">Login</h3>

                <form id="loginForm">
                    <input
                        type="email"
                        id="loginEmail"
                        class="form-control mb-3"
                        placeholder="Email"
                        required
                    >

                    <input
                        type="password"
                        id="loginPassword"
                        class="form-control mb-3"
                        placeholder="Password"
                        required
                    >

                    <button type="submit" class="btn btn-success">
                        Login
                    </button>
                </form>
            </div>
        </div>

    </div>
</section>


    <!-- Home Section -->
    <section id="home" class="hero text-center">

        <div class="container">

            <h1 class="display-4 fw-bold animate-title">
                Student Registration
            </h1>

            <p class="lead">
                Register yourself for your preferred course.
            </p>

            <a href="#register" class="btn btn-light">
                Register Now
            </a>

        </div>

    </section>


    <!-- Registration Section -->
    <section id="register" class="py-5">

        <div class="container">

            <div class="row justify-content-center">

                <div class="col-lg-7">

                    <div class="card form-card border-0 shadow p-4">

                        <h2 class="text-center mb-4">
                            Registration Form
                        </h2>


                        <!-- Registration Form -->
                        <form id="studentForm">

                            <!-- Name -->
                            <div class="mb-3">

                                <label class="form-label">
                                    Name
                                </label>

                                <input
                                    type="text"
                                    id="name"
                                    name="name"
                                    class="form-control"
                                >

                            </div>


                            <!-- Email -->
                            <div class="mb-3">

                                <label class="form-label">
                                    Email
                                </label>

                                <input
                                    type="email"
                                    id="email"
                                    name="email"
                                    class="form-control"
                                >

                            </div>


                            <!-- Age -->
                            <div class="mb-3">

                                <label class="form-label">
                                    Age
                                </label>

                                <input
                                    type="number"
                                    id="age"
                                    name="age"
                                    class="form-control"
                                >

                            </div>


                            <!-- Password -->
                            <div class="mb-3">

                                <label class="form-label">
                                    Password
                                </label>

                                <input
                                    type="password"
                                    id="password"
                                    name="password"
                                    class="form-control"
                                >

                                <small
                                    id="passwordMessage"
                                    class="text-muted"
                                >
                                    Password must contain at least 8 characters,
                                    one uppercase letter, one lowercase letter,
                                    one number and one special character.
                                </small>

                            </div>


                            <!-- Course -->
                            <div class="mb-3">

                                <label class="form-label">
                                    Course
                                </label>

                                <select
                                    id="course"
                                    name="course"
                                    class="form-select"
                                >

                                    <option value="">
                                        Select Course
                                    </option>

                                    <option value="Web Development">
                                        Web Development
                                    </option>

                                    <option value="JavaScript">
                                        JavaScript
                                    </option>

                                    <option value="Python">
                                        Python
                                    </option>

                                </select>

                            </div>


                            <!-- Dynamic Course Information -->
                            <div
                                id="courseInfo"
                                class="alert alert-info"
                            >
                            </div>


                            <!-- Register Button -->
                            <button
                                type="submit"
                                class="btn btn-dark w-100"
                            >
                                Register
                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- Registered Students Section -->
    <section class="py-5 bg-light">

        <div class="container">

            <h2 class="text-center mb-4">
                Registered Students
            </h2>

            <div
                id="studentsList"
                class="row g-4"
            >

                <p class="text-center">
                    Loading students...
                </p>

            </div>

        </div>

    </section>


    <!-- Features Section -->
    <section class="py-5 bg-white">

        <div class="container">

            <h2 class="text-center mb-4">
                Why Register?
            </h2>

            <div class="row g-4">

                <div class="col-md-4">

                    <div class="card feature-card h-100 border-0 shadow-sm p-3">

                        <h4>
                            Easy Registration
                        </h4>

                        <p>
                            Simple and user-friendly registration process.
                        </p>

                    </div>

                </div>


                <div class="col-md-4">

                    <div class="card feature-card h-100 border-0 shadow-sm p-3">

                        <h4>
                            Responsive Design
                        </h4>

                        <p>
                            The page works on desktop, tablet and mobile screens.
                        </p>

                    </div>

                </div>


                <div class="col-md-4">

                    <div class="card feature-card h-100 border-0 shadow-sm p-3">

                        <h4>
                            Validated Data
                        </h4>

                        <p>
                            User information is validated before submission.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- Footer -->
    <footer class="bg-dark text-white text-center py-3">

        <p class="mb-0">
            Student Portal | Cognifyz Internship
        </p>

    </footer>


    <!-- JavaScript -->
    <script>

        // ==============================
        // Password Strength
        // ==============================

        function checkPasswordStrength() {

            const password =
                document.getElementById("password").value;

            const message =
                document.getElementById("passwordMessage");

            const strongPassword =
                /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9]).{8,}$/;

            if (password === "") {

                message.textContent =
                    "Password is required.";

            } else if (strongPassword.test(password)) {

                message.textContent =
                    "Strong password.";

            } else {

                message.textContent =
                    "Weak password. Use 8+ characters, uppercase, lowercase, number and special character.";

            }

        }


        // ==============================
        // Course Information
        // ==============================

        function updateCourseInfo() {

            const course =
                document.getElementById("course").value;

            const courseInfo =
                document.getElementById("courseInfo");

            if (course === "") {

                courseInfo.style.display = "none";
                courseInfo.textContent = "";

            } else {

                courseInfo.style.display = "block";

                courseInfo.textContent =
                    "You selected: " +
                    course +
                    ". This course is available for registration.";

            }

        }


        // ==============================
        // Form Validation
        // ==============================

        function validateForm() {

            const name =
                document.getElementById("name").value.trim();

            const email =
                document.getElementById("email").value.trim();

            const age =
                document.getElementById("age").value;

            const password =
                document.getElementById("password").value;

            const course =
                document.getElementById("course").value;


            if (
                name === "" ||
                email === "" ||
                age === "" ||
                password === "" ||
                course === ""
            ) {

                alert("Please fill all fields.");

                return false;

            }


            if (age < 13 || age > 100) {

                alert("Please enter a valid age.");

                return false;

            }


            const strongPassword =
                /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9]).{8,}$/;


            if (!strongPassword.test(password)) {

                alert(
                    "Password must contain 8+ characters, uppercase, lowercase, number and special character."
                );

                return false;

            }


            return true;

        }


        // ==============================
        // Password Event
        // ==============================

        document
            .getElementById("password")
            .addEventListener(
                "input",
                checkPasswordStrength
            );


        // ==============================
        // Course Event
        // ==============================

        document
            .getElementById("course")
            .addEventListener(
                "change",
                updateCourseInfo
            );


        // ==============================
        // Client-side Routing
        // ==============================

        window.addEventListener(
            "hashchange",
            function () {

                const section =
                    window.location.hash;

                if (section === "#register") {

                    document
                        .getElementById("register")
                        .scrollIntoView({
                            behavior: "smooth"
                        });

                } else {

                    document
                        .getElementById("home")
                        .scrollIntoView({
                            behavior: "smooth"
                        });

                }

            }
        );


        // ==============================
        // Load Students from API
        // ==============================

        async function loadStudents() {

    try {

        const token = localStorage.getItem("token");

        const response =
            await fetch("/api/students", {
                headers: {
                    "Authorization": "Bearer " + token
                }
            });

        const students =
            await response.json();

                const studentsList =
                    document.getElementById("studentsList");

                studentsList.innerHTML = "";


                students.forEach(student => {

                    const card =
                        document.createElement("div");

                    card.className =
                        "col-md-6 col-lg-4";


                    card.innerHTML = `
    <div class="card shadow-sm h-100 p-3">

        <h4>${student.name}</h4>

        <p>
            <strong>Email:</strong>
            ${student.email}
        </p>

        <p>
            <strong>Age:</strong>
            ${student.age}
        </p>

        <p>
            <strong>Course:</strong>
            ${student.course}
        </p>

        <div class="d-flex gap-2 mt-3">

            <button
                class="btn btn-warning btn-sm"
                onclick="updateStudent(${student.id})"
            >
                Update
            </button>

            <button
                class="btn btn-danger btn-sm"
                onclick="deleteStudent(${student.id})"
            >
                Delete
            </button>

        </div>

    </div>
`;

                    studentsList.appendChild(card);

                });


            } catch (error) {

                console.error(
                    "Error loading students:",
                    error
                );

                document.getElementById("studentsList").innerHTML =
                    "<p class='text-center text-danger'>Unable to load students.</p>";

            }

        }


        // ==============================
        // Submit Student to API
        // ==============================

        document
            .getElementById("studentForm")
            .addEventListener(
                "submit",
                async function (event) {

                    event.preventDefault();


                    // Validate form
                    if (!validateForm()) {

                        return;

                    }


                    const studentData = {

                        name:
                            document.getElementById("name").value.trim(),

                        email:
                            document.getElementById("email").value.trim(),

                        age:
                            document.getElementById("age").value,

                        course:
                            document.getElementById("course").value

                    };


                    try {

                        const token = localStorage.getItem("token");

                        const response = await fetch("/api/students", {
                         method: "POST",
                             headers: {
                                 "Content-Type": "application/json",
                                   "Authorization": "Bearer " + token
                            },
                           body: JSON.stringify(studentData)
                            });

                        const result =
                            await response.json();


                        if (!response.ok) {

                            alert(result.message);

                            return;

                        }


                        alert(
                            "Student registered successfully!"
                        );


                        // Clear form
                        document
                            .getElementById("studentForm")
                            .reset();


                        // Hide course information
                        updateCourseInfo();


                        // Refresh student list
                        loadStudents();


                    } catch (error) {

                        console.error(
                            "Error:",
                            error
                        );

                        alert(
                            "Something went wrong!"
                        );

                    }

                }
            );


        // ==============================
        // Load API Data
        // ==============================
        async function deleteStudent(id) {

    const confirmDelete = confirm("Are you sure you want to delete this student?");

    if (!confirmDelete) {
        return;
    }

    const response = await fetch(`/api/students/${id}`, {
        method: "DELETE"
    });

    const result = await response.json();

    alert(result.message);

    loadStudents();
}


async function updateStudent(id) {

    const name = prompt("Enter new name:");

    if (!name) return;

    const email = prompt("Enter new email:");

    if (!email) return;

    const age = prompt("Enter new age:");

    if (!age) return;

    const course = prompt("Enter new course:");

    if (!course) return;


    const response = await fetch(`/api/students/${id}`, {

        method: "PUT",

        headers: {
            "Content-Type": "application/json"
        },

        body: JSON.stringify({
            name: name,
            email: email,
            age: age,
            course: course
        })

    });


    const result = await response.json();

    alert(result.message);

    loadStudents();
}
        loadStudents();

        // ==============================
// User Registration
// ==============================

document
    .getElementById("registerForm")
    .addEventListener("submit", async function(event) {

        event.preventDefault();

        const name =
            document.getElementById("registerName").value.trim();

        const email =
            document.getElementById("registerEmail").value.trim();

        const password =
            document.getElementById("registerPassword").value;

        try {
            const response = await fetch("/api/register", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    name: name,
                    email: email,
                    password: password
                })
            });

            const result = await response.json();

            alert(result.message);

            if (response.ok) {
                document
                    .getElementById("registerForm")
                    .reset();
            }

        } catch (error) {
            console.error(error);
            alert("Registration failed: " + error.message);
        }
    });

    // ==============================
// User Login
// ==============================

document
    .getElementById("loginForm")
    .addEventListener("submit", async function(event) {

        event.preventDefault();

        const email =
            document.getElementById("loginEmail").value.trim();

        const password =
            document.getElementById("loginPassword").value;

        try {
            const response = await fetch("/api/login", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    email: email,
                    password: password
                })
            });

            const result = await response.json();

            if (!response.ok) {
                alert(result.message);
                return;
            }

            localStorage.setItem("token", result.token);

                   alert("Login successful!");

                   loadStudents();

        } catch (error) {
            console.error(error);
            alert("Login failed: " + error.message);
        }
    });

    </script>

</body>

</html>